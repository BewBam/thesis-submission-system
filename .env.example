# Copy to `.env` in this directory (Docker Compose) and/or `backend/.env` (local Nest).
# Never commit a real `.env` — it contains secrets.

# --- Email (SMTP) ---
# Workflow recipients (student / reviewer / library staff / director) are unchanged.
# Switch providers later by changing these variables only (no code change).

# Set true to send mail. If unset, admin System settings `email_enabled` is used.
EMAIL_ENABLED=true

# Development / testing: personal Gmail (STARTTLS).
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=Thesis Portal <your.gmail@gmail.com>

# Later: university SMTP — keep the same variable names, change values, for example:
# SMTP_HOST=smtp.hcmut.edu.vn
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@hcmut.edu.vn
# SMTP_PASSWORD=...
# SMTP_FROM=Thesis Portal <noreply@hcmut.edu.vn>

# --- Google OAuth (HCMUT) ---
# Redirect URI must match the Google Cloud OAuth client exactly.
# Do not commit GOOGLE_CLIENT_SECRET. Reset the secret if it was ever pasted in chat.
GOOGLE_CLIENT_ID=773482846011-4r8veam5enru6dps0t80hdiepie10rtl.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=hcmut.edu.vn
FRONTEND_URL=http://localhost:5173
